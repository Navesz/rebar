{
  "name": "rebar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rebar": "tooling/rebar-check/index.mjs",
    "rebar-new": "new/index.mjs",
    "rebar-security": "tooling/security/index.mjs"
  },
  "scripts": {
    "verify": "node tooling/verify/verify.mjs",
    "prove": "node tooling/rebar-check/proofs/prove.mjs",
    "check": "node tooling/rebar-check/index.mjs .",
    "install-hooks": "node tooling/hooks/install.mjs",
    "format-check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "security": "node tooling/security/index.mjs .",
    "prove-security": "node tooling/rebar-check/proofs/prove.mjs --checker=tooling/security/index.mjs --cases=tooling/security/proofs/cases"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
