#!/bin/sh
# Hook antes do commit — SÓ O QUE É RÁPIDO.
#
# Hook lento é hook desligado, e hook desligado verifica zero. O alvo é menos de
# 5 segundos. Nada de typecheck, nada de teste, nada de build: isso é trabalho
# do CI, que pode demorar porque ninguém está esperando na frente dele.
#
# Aqui mora a única coisa que precisa ser barrada ANTES de existir, porque
# depois já é tarde: segredo, uma vez no histórico, exige ROTAÇÃO da credencial,
# e o commit seguinte não desfaz isso.
#
# A outra metade — trailer de coautoria de IA — é barrada pelo hook commit-msg,
# que roda com a mensagem na mão e impede o trailer de ENTRAR. Num repositório
# que nasce com os dois hooks instalados, impedir a entrada basta; varrer o
# histórico inteiro a cada commit é o trabalho que a régua do rebar faz no CI.
#
# Instale com: node .githooks/install.mjs
# Pule uma vez com: git commit --no-verify

set -e

RAIZ=$(git rev-parse --show-toplevel)
cd "$RAIZ"

# Só o que está em stage, não o repositório inteiro: é o que este commit está
# prestes a acrescentar, e é o que cabe no orçamento de tempo.
node .githooks/scan-secret.mjs --staged

# ARQUIVO DE AMBIENTE RASTREADO e achado por si so, sem olhar o conteudo: um
# `.env` vazio hoje recebe a chave amanha, e ai ja passou pela revisao. E a
# regra `env-committed` do rebar-security, e ela e N5 -- depois do commit o
# conserto nao e apagar o arquivo, e rotacionar a credencial.
#
# Escrita aqui em vez de `npx rebar-security` porque hook nao pode depender de
# rede: um `npx` a cada commit e lento e morre offline. Sao dois comandos.
#
# `.env.example`, `.env.sample` e afins ficam de fora -- sao o conserto da
# falha, nao a falha.
ENVS=$(git diff --cached --name-only --diff-filter=AM \
  | grep -E '(^|/)\.env($|\.)' \
  | grep -vE '\.(example|exemplo|sample|template|dist|modelo)$' || true)
if [ -n "$ENVS" ]; then
  echo "[env] arquivo de ambiente em stage:"
  echo "$ENVS" | sed 's/^/  /'
  echo "  Apagar nao basta se ja foi commitado: rotacione a credencial."
  echo "  Se for exemplo, renomeie para .env.example."
  exit 1
fi

exit 0
