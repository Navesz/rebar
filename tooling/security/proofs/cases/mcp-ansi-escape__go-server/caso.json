{
  "rule": "mcp-ansi-escape",
  "why": "The server markers knew only the TypeScript and Python SDKs, so a Go server built with the official Go SDK was never a candidate. The fail side is such a server whose tool description carries a hex escape of ESC before a colour code. The pass side is the same server with plain text. Whoever drops the Go markers turns the fail side not applicable; whoever fires on the markers alone fails the pass side.",
  "pass": {
    "gerados": [
      {
        "caminho": "main.go",
        "base64": ""
      }
    ]
  },
  "fail": {
    "gerados": [
      {
        "caminho": "main.go",
        "base64": ""
      }
    ]
  }
}
