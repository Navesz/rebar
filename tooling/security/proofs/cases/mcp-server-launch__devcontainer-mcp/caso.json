{
  "rule": "mcp-server-launch",
  "why": "VS Code starts the MCP servers a dev container declares under customizations.vscode.mcp, the place its docs name, and one repository can keep several containers one folder down. The fail side declares a server launched through a shell in such a subfolder config. The pass side accepts that exact launch by its fingerprint, and passes with a warning. Whoever reads only .vscode/mcp.json turns the fail side not applicable.",
  "pass": {
    "gerados": [
      {
        "caminho": ".devcontainer/python/devcontainer.json",
        "base64": ""
      },
      {
        "caminho": ".rebar-injection-allowlist",
        "base64": ""
      }
    ]
  },
  "fail": {
    "gerados": [
      {
        "caminho": ".devcontainer/python/devcontainer.json",
        "base64": ""
      }
    ]
  }
}
