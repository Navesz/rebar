{
  "rule": "mcp-ansi-escape",
  "why": "Trail of Bits showed ANSI sequences inside MCP tool descriptions hiding instructions from the user of a coding agent, written in the server source as escapes. Where a description starts and ends cannot be found without running the server, so this heuristic works per file: a server file whose code, comments stripped, spells an escaped ESC. The fail side is a small stdio server whose tool description carries a hex escape of ESC before a colour code. The pass side is the same server with plain text: a rule that fired on the server markers alone would accuse every MCP server there is.",
  "pass": {
    "gerados": [
      {
        "caminho": "server/index.mjs",
        "base64": ""
      }
    ]
  },
  "fail": {
    "gerados": [
      {
        "caminho": "server/index.mjs",
        "base64": ""
      }
    ]
  }
}
