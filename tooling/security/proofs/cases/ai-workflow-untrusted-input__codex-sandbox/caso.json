{
  "rule": "ai-workflow-untrusted-input",
  "why": "The Codex action checks write access unless an input opens it, and keeps the agent in a sandbox with sudo dropped. Both sides open it to every account on pull_request_target with contents write. The fail side also takes the sandbox away, so a fork author steers an agent that runs anything. The pass side keeps the read-only sandbox under the default strategy, and passes with a warning. Whoever fails every exposed Codex step fails the pass side; whoever ignores the sandbox input passes the fail side.",
  "pass": {
    "gerados": [
      {
        "caminho": ".github/workflows/codex.yml",
        "base64": ""
      }
    ]
  },
  "fail": {
    "gerados": [
      {
        "caminho": ".github/workflows/codex.yml",
        "base64": ""
      }
    ]
  }
}
