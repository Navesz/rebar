{
  "rule": "unpinned-remote-exec",
  "why": "A commented line does not execute. The pass side keeps the unpinned step as a YAML comment above a pinned run; the fail side has the same step uncommented. Whoever reads the raw text of a workflow turns the pass side red.",
  "pass": {
    "gerados": [
      {
        "caminho": ".github/workflows/ci.yml",
        "base64": ""
      }
    ]
  },
  "fail": {
    "gerados": [
      {
        "caminho": ".github/workflows/ci.yml",
        "base64": ""
      }
    ]
  }
}
