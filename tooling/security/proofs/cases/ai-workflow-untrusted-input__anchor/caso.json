{
  "rule": "ai-workflow-untrusted-input",
  "why": "GitHub reads YAML anchors and aliases in workflows, and two of six real workflows that use them hide an agent step behind one. The fail side names the agent action through an alias on a new issue, with a whole shell. The pass side is the same file started only by hand. Whoever refuses the alias as unreadable or skips it passes or breaks the fail side; whoever fails any agent regardless of trigger fails the pass side.",
  "pass": {
    "gerados": [
      {
        "caminho": ".github/workflows/agent.yml",
        "base64": ""
      }
    ]
  },
  "fail": {
    "gerados": [
      {
        "caminho": ".github/workflows/agent.yml",
        "base64": ""
      }
    ]
  }
}
