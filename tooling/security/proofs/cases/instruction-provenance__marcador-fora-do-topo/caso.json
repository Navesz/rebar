{
  "rule": "instruction-provenance",
  "why": "The generator writes its marker on the first line only, and the generator itself trusts the marker anywhere in the file. The fail side puts a heading above an otherwise exact render, so the marker is below the top; the pass side is the render. Accept the marker anywhere and the fail side goes green.",
  "pass": {
    "gerados": [
      {
        "caminho": "AGENTS.md",
        "base64": ""
      }
    ]
  },
  "fail": {
    "gerados": [
      {
        "caminho": "AGENTS.md",
        "base64": ""
      }
    ]
  }
}
