#!/bin/sh
# Pre-commit hook — ONLY WHAT IS FAST.
#
# A slow hook is a disabled hook, and a disabled hook verifies zero. The target
# is under 5 seconds. No typecheck, no test, no build: that is the CI's work,
# and the CI is allowed to take long because nobody is waiting in front of it.
#
# Here live the two things that have to be blocked BEFORE they exist, because
# afterwards it is already too late. In both, a new commit does not fix it:
#   · a secret, once in history, demands ROTATING the credential;
#   · an AI co-authorship trailer, once in history, only comes out by rewriting
#     history — which is a force operation, not a routine one.
#
# Install with: node tooling/hooks/install.mjs
# Skip once with: git commit --no-verify

set -e

RAIZ=$(git rev-parse --show-toplevel)
cd "$RAIZ"

# 1. Secret in what is staged. The stage only, not the whole repository: it is
#    what the commit is about to add, and it is what fits the budget.
node tooling/secret/scan-secret.mjs --staged

# 2. AI co-authorship in history. One rule only, and the reason is NOT time:
#    measured against this repository, the rule alone takes 0.237 s and the full
#    scoreboard takes 0.246 s. The reason is the verdict. The full scoreboard
#    exits 1 as long as there is ONE open hole — and there always is. Put in the
#    hook, it would block every commit over old debt that the commit did not
#    introduce, and within a week someone aliases --no-verify and the hook stops
#    existing. The hook blocks only what this commit is adding; the whole
#    scoreboard is the CI's work.
#
#    Division of labor with the commit-msg hook: rebar-check reads `git log`, and
#    the commit in progress is not there yet — this step stops the trailer from
#    STAYING. Stopping it from GETTING IN is the commit-msg's job, and it runs
#    with the message in hand.
node tooling/rebar-check/index.mjs --rule=ai-coauthorship

exit 0
